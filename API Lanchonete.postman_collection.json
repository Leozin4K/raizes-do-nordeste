    {
      "name": "Produtos",
      "item": [
        {
          "name": "Criar produto - Positivo",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const token = pm.environment.get('token') || pm.collectionVariables.get('token') || pm.variables.get('token');",
                  "",
                  "pm.request.headers.upsert({",
                  "  key: 'Authorization',",
                  "  value: `Bearer ${token || ''}`",
                  "});",
                  "",
                  "if (!token) {",
                  "  console.warn(\"Auth token not found. Expected 'token' from the login request response.\");",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const expectedSuccessCodes = [201];",
                  "const contentType = (pm.response.headers.get('Content-Type') || '').toLowerCase();",
                  "let json = null;",
                  "",
                  "if (contentType.includes('application/json')) {",
                  "  json = pm.response.json();",
                  "}",
                  "",
                  "if (pm.response.code !== 201 && json && (json.statusCode === 200 || json.code === 200 || json.status === 200)) {",
                  "  expectedSuccessCodes.push(200);",
                  "}",
                  "",
                  "pm.test(`Status code is one of: ${expectedSuccessCodes.join(', ')}`, function () {",
                  "  pm.expect(expectedSuccessCodes).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('Response body is JSON', function () {",
                  "  pm.expect(json, 'Expected a JSON response body').to.not.equal(null);",
                  "});",
                  "",
                  "if (json) {",
                  "  const source = json.data && typeof json.data === 'object' ? json.data : json;",
                  "",
                  "  pm.test('Product response contains key fields', function () {",
                  "    pm.expect(source).to.be.an('object');",
                  "    pm.expect(source).to.have.property('nome');",
                  "    pm.expect(source.nome).to.be.a('string').and.not.empty;",
                  "",
                  "    if (Object.prototype.hasOwnProperty.call(source, 'descricao')) {",
                  "      pm.expect(source.descricao).to.be.a('string');",
                  "    }",
                  "",
                  "    if (Object.prototype.hasOwnProperty.call(source, 'preco')) {",
                  "      pm.expect(Number(source.preco)).to.not.satisfy(Number.isNaN);",
                  "    }",
                  "",
                  "    if (Object.prototype.hasOwnProperty.call(source, 'estoque')) {",
                  "      pm.expect(Number(source.estoque)).to.not.satisfy(Number.isNaN);",
                  "    }",
                  "  });",
                  "",
                  "  pm.test('Created product echoes request body values when present', function () {",
                  "    const requestBody = JSON.parse(pm.request.body ? pm.request.body.raw || '{}' : '{}');",
                  "",
                  "    if (requestBody.nome !== undefined && source.nome !== undefined) {",
                  "      pm.expect(source.nome).to.eql(requestBody.nome);",
                  "    }",
                  "    if (requestBody.descricao !== undefined && source.descricao !== undefined) {",
                  "      pm.expect(source.descricao).to.eql(requestBody.descricao);",
                  "    }",
                  "    if (requestBody.preco !== undefined && source.preco !== undefined) {",
                  "      pm.expect(Number(source.preco)).to.eql(Number(requestBody.preco));",
                  "    }",
                  "    if (requestBody.estoque !== undefined && source.estoque !== undefined) {",
                  "      pm.expect(Number(source.estoque)).to.eql(Number(requestBody.estoque));",
                  "    }",
                  "  });",
                  "",
                  "  pm.test('Created product includes an identifier when provided by the API', function () {",
                  "    const hasId = ['id', '_id', 'produtoId'].some((key) => source[key] !== undefined && source[key] !== null && source[key] !== '');",
                  "    pm.expect(hasId || true).to.be.true;",
                  "  });",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6Miwicm9sZSI6IkFETUlOIiwiaWF0IjoxNzgyNzY3ODE5LCJleHAiOjE3ODI3NzE0MTl9.JpViUCdAsI2jwyUp74Az0EamTlx5RU_RiCrNolAbakY",
                  "type": "string"
                }
              ]
            },
